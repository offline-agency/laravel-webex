{
  "name": "offline-agency/laravel-webex",
  "description": "A simple integration with Webex",
  "keywords": [
    "offline-agency",
    "integration",
    "api",
    "laravel",
    "webex"
  ],
  "homepage": "https://github.com/offline-agency/laravel-webex",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Offline Agency",
      "email": "support@offlineagency.it",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "~8.4.0 || ~8.5.0",
    "ext-json": "*",
    "laravel/framework": "^12.69.2 || ^13.32"
  },
  "require-dev": {
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.32",
    "mockery/mockery": "^1.6.12",
    "orchestra/testbench": "^10.12 || ^11.3",
    "pestphp/pest": "^4.7",
    "pestphp/pest-plugin-laravel": "^4.1"
  },
  "autoload": {
    "psr-4": {
      "Offlineagency\\LaravelWebex\\": "src",
      "Offlineagency\\LaravelWebex\\Http\\": "Http"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Offlineagency\\LaravelWebex\\Tests\\": "tests",
      "Offlineagency\\LaravelWebex\\Release\\": "tools/release/src"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/pest",
    "test-coverage": "@php vendor/bin/pest --coverage-html coverage",
    "stan": "@php vendor/bin/phpstan analyse --memory-limit=512M",
    "pint": "@php vendor/bin/pint",
    "pint:check": "@php vendor/bin/pint --test"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Offlineagency\\LaravelWebex\\Providers\\LaravelWebexServiceProvider"
      ],
      "aliases": {
        "LaravelWebex": "Offlineagency\\LaravelWebex\\LaravelWebexFacade"
      }
    }
  }
}
