{
  "name": "offline-agency/laravel-webex",
  "description": "A simple integration with Webex",
  "keywords": [
    "offline-agency",
    "integration",
    "api",
    "laravel",
    "webex"
  ],
  "homepage": "https://github.com/offline-agency/laravel-webex",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Offline Agency",
      "email": "support@offlineagency.it",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/container": "^11.0|^12.0",
    "illuminate/http": "^11.0|^12.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.27",
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^9.0|^10.0",
    "pestphp/pest": "^3.0",
    "pestphp/pest-plugin-laravel": "^3.0",
    "php-coveralls/php-coveralls": "^2.4",
    "phpunit/phpunit": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Offlineagency\\LaravelWebex\\": "src",
      "Offlineagency\\LaravelWebex\\Http\\": "Http"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Offlineagency\\LaravelWebex\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "test-coverage": "vendor/bin/pest --coverage-html coverage",
    "stan": "vendor/bin/phpstan analyse --memory-limit=512M"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true,
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Offlineagency\\LaravelWebex\\Providers\\LaravelWebexServiceProvider"
      ],
      "aliases": {
        "LaravelWebex": "Offlineagency\\LaravelWebex\\LaravelWebexFacade"
      }
    }
  }
}
